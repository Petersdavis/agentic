# ==============================================================================
# Agentic Orchestrator - Environment Configuration Template
# Copy this file to .env and provide your API keys.
# ==============================================================================

# --- Model Provider API Keys ---
# OpenAI is used for Planner/Orchestrator, Product Strategist, and Reviewer
OPENAI_API_KEY=your_openai_api_key_here

# DeepSeek is used for Code Writer / Worker agents
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional secondary/fallback providers
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Model Role Assignments ---
ROLE_ORCHESTRATOR_PROVIDER=openai
ROLE_ORCHESTRATOR_MODEL=gpt-4o

ROLE_PRODUCT_PROVIDER=openai
ROLE_PRODUCT_MODEL=gpt-4o

ROLE_PLANNER_PROVIDER=openai
ROLE_PLANNER_MODEL=gpt-4o

ROLE_REVIEWER_PROVIDER=openai
ROLE_REVIEWER_MODEL=gpt-4o

ROLE_CODER_PROVIDER=deepseek
ROLE_CODER_MODEL=deepseek-chat

# --- Runtime & Docker Configuration ---
DOCKER_DEFAULT_TIMEOUT=300
